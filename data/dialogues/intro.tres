[gd_resource type="Resource" script_class="DialogueSequence" load_steps=4 format=3]
[ext_resource type="Script" path="res://scripts/ui/data/dialogue_sequence.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/portraits/player.png" id="2"]
[ext_resource type="Texture2D" path="res://assets/portraits/curator.png" id="3"]
[resource]
script = ExtResource("1")
player_portrait = ExtResource("2")
curator_portrait = ExtResource("3")
player_name = "YOU / TRAINEE"
curator_name = "CURATOR / ID REDACTED"
desktop_reveal_after = 4
lines = Array[Dictionary]([{
"speaker": "curator", "text": "Wake the fuck up, samurai. We have asses to crack"
}, {
"speaker": "player", "text": "Is that the official onboarding?"
}, {
"speaker": "curator", "text": "No. The official one costs extra."
}, {
"speaker": "player", "text": "Great. What am I breaking?"
}, {
"speaker": "curator", "text": "ANUS INDUSTRIES. HR portal. Lexa's account. We need the layoff order."
}, {
"speaker": "player", "text": "A corporate account? This is my first job."
}, {
"speaker": "curator", "text": "The target is a fucking amateur. This is intern work. Try not to turn it into a funeral."
}, {
"speaker": "player", "text": "Where do I start?"
}, {
"speaker": "curator", "text": "Open G-D's Eye. Learn his habits. Build a small dictionary. Then send it."
}, {
"speaker": "player", "text": "Why small?"
}, {
"speaker": "curator", "text": "Every query and every login leaves a footprint. At 100 Exposure, the lesson ends."
}, {
"speaker": "player", "text": "And you are...?"
}, {
"speaker": "curator", "text": "The voice you don't mention in your report. Open your tools."
}])
