[gd_resource type="Resource" load_steps=2 format=3]
[ext_resource type="Script" path="res://scripts/ui/data/desktop_copy.gd" id="1"]
[resource]
script = ExtResource("1")
help_text = "1. Open G-D's Eye. Click a source, then Query to retrieve information.\nRecon costs Exposure once. Reading it again is free; new branches can appear.\n2. Type relevant words and numbers into Dictionary. Enter saves each fragment.\n3. Run dictionary sends password candidates to the known account through your botnet.\n\nEach fragment is used at most once, in all orders and nonempty subsets.\nCase stays as typed. Fewer candidates are faster and cost less Exposure.\nSPECIALS: five slots with plain, !, ?, #, a → @, a → @ plus !.\nNormal: up to 1956 candidates. Special: up to 1950.\n\nAt service coefficient 1, 1956 login attempts take exactly 60 seconds.\nTime = 60 × service coefficient × candidate count / 1956.\nLaunch costs 2 Exposure; every sent request costs 18 / 1956.\nA full pass costs 20. Early success and Stop avoid unsent requests.\nAt 100 Exposure, the operation is traced. Recon shares this budget.\n\nDrag titlebars to move windows. X closes the view, preserving its state.\nThe botnet keeps running in the background. Stop it from the taskbar.\nDesktop shortcuts and taskbar buttons reopen applications."
location = "PERM-2091 / BOTNET SIM"
idle_voices = PackedStringArray("“I'm not a cat. I'm your burnout interface.” — ?", "“They updated the password policy. Not the people.” — ?", "“Your request matters to us. Especially the last one.” — ?")
